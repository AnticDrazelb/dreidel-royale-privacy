# ---------------------------------------------------------------
# Unity
#
# Everything below is regenerated by the editor from Assets/,
# Packages/ and ProjectSettings/. Library alone is tens of thousands
# of binary files and is different on every machine, so committing it
# is both enormous and useless.
# ---------------------------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Never open the repo root as a Unity project — the project lives in
# unity/DreidelRoyale. These are what the editor leaves behind if you do.
/Assets/
/Packages/
/ProjectSettings/

# Asset meta files must be committed for anything that IS in the project,
# but never for a folder git isn't tracking.
/[Aa]ssets/**/*.meta

# Unity rewrites these on every open, with its own exact build hash and its own
# package resolution. Tracking them means a pull that touches them is refused for
# "local changes that would be overwritten" — which blocks the whole pull, not just
# that file, and looks exactly like a pull that silently did nothing. The editor
# version this project wants is stated in unity/README.md instead.
unity/DreidelRoyale/ProjectSettings/ProjectVersion.txt
unity/DreidelRoyale/Packages/packages-lock.json

# Fetched package sources for the API checker — tens of MB of Unity's own code,
# reproducible with `python3 unity/tools/apicheck/verify.py --fetch`.
unity/tools/apicheck/.cache/

# Generated IDE and build files
.vs/
.vsconfig
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D-generated crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.ipa
*.unitypackage
*.app

# OS
.DS_Store
Thumbs.db
