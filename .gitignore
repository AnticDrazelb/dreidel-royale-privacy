# ---------------------------------------------------------------
# Unity
#
# Everything below is regenerated by the editor from Assets/,
# Packages/ and ProjectSettings/. Library alone is tens of thousands
# of binary files and is different on every machine, so committing it
# is both enormous and useless.
# ---------------------------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Never open the repo root as a Unity project — the project lives in
# unity/DreidelRoyale. These are what the editor leaves behind if you do.
/Assets/
/Packages/
/ProjectSettings/

# Asset meta files must be committed for anything that IS in the project,
# but never for a folder git isn't tracking.
/[Aa]ssets/**/*.meta

# Generated IDE and build files
.vs/
.vsconfig
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D-generated crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.ipa
*.unitypackage
*.app

# OS
.DS_Store
Thumbs.db
